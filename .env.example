# Copy this file to .env and fill in real values. Never commit .env.

# ── AI provider — change via the ⚙️ AI Settings panel in the app ──────────────
# AI_PROVIDER: ollama | openai | claude | deepseek | qwen | kimi
AI_PROVIDER=ollama

# Ollama (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude / Anthropic (used when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# DeepSeek (used when AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Alibaba Qwen / DashScope (used when AI_PROVIDER=qwen)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# Moonshot Kimi (used when AI_PROVIDER=kimi)
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

# ── SMTP (required for sending emails and auto-replies) ───────────────────────
# SMTP_SECURITY: starttls (port 587, most providers), ssl (port 465), none (port 25)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_SECURITY=starttls

# ── IMAP (required for inbox monitoring) ──────────────────────────────────────
# Optional: separate IMAP credentials. If unset, falls back to SMTP_USERNAME/PASSWORD.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=

# ── Auto follow-ups (manage via Conversations tab in the app) ─────────────────
# When enabled, prospects who don't reply within DELAY_HOURS get an AI-drafted
# follow-up queued for 5-minute review, then auto-sent. Capped at MAX_COUNT.
FOLLOWUP_ENABLED=false
FOLLOWUP_DELAY_HOURS=24
FOLLOWUP_MAX_COUNT=2

# ── Booking / scheduling link ─────────────────────────────────────────────────
# Your own Cal.com, Calendly, or similar booking URL.
# When set, the app appends this link to cold-outreach auto-replies so
# interested prospects can schedule a call directly.
# Leave empty to omit booking links from replies.
COLD_OUTREACH_BOOKING_URL=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Set to "production" to enforce hardened defaults (FLASK_SECRET_KEY required, etc.)
APP_ENV=development
ALLOW_SELF_SIGNUP=true
